{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "app/*"
      ],
      "@database/*": [
        "database/*"
      ],
      "~/*": [
        "routes/*",
        ".bunyad/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "routes/**/*.tsx",
    "app/**/*.tsx",
    ".bunyad/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
