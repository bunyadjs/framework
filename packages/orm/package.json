{
  "name": "@bunyad/orm",
  "version": "0.2.0-beta.2",
  "description": "Active-record ORM for Bunyad: models, relations, casts, scopes, events, factories.",
  "license": "MIT",
  "author": "Shah Khalid",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunyadjs/framework.git",
    "directory": "packages/orm"
  },
  "homepage": "https://github.com/bunyadjs/framework#readme",
  "bugs": {
    "url": "https://github.com/bunyadjs/framework/issues"
  },
  "keywords": [
    "bunyad",
    "bun",
    "typescript",
    "orm",
    "active-record"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@bunyad/common": "workspace:^",
    "@bunyad/database": "workspace:^"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun ../../scripts/build-package.ts ."
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
