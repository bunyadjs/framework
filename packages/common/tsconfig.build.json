{
  "extends": "../../tsconfig.build-base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@bunyad/contracts": [
        "../contracts/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.node-test.ts",
    "src/**/*.spike.test.ts"
  ]
}
