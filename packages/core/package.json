{
  "name": "@bunyad/core",
  "version": "0.2.0-beta.0",
  "description": "Application kernel for Bunyad: bootstrapping, providers and the HTTP lifecycle.",
  "license": "MIT",
  "author": "Shah Khalid",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunyadjs/framework.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/bunyadjs/framework#readme",
  "bugs": {
    "url": "https://github.com/bunyadjs/framework/issues"
  },
  "keywords": [
    "bunyad",
    "bun",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./globals": {
      "types": "./src/globals.ts",
      "default": "./src/globals.ts"
    }
  },
  "dependencies": {
    "@bunyad/common": "workspace:^",
    "@bunyad/config": "workspace:^",
    "@bunyad/container": "workspace:^",
    "@bunyad/contracts": "workspace:^",
    "@bunyad/http": "workspace:^",
    "@bunyad/router": "workspace:^",
    "@bunyad/validation": "workspace:^",
    "@bunyad/view": "workspace:^"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun ../../scripts/build-package.ts ."
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./globals": {
        "types": "./dist/globals.d.ts",
        "default": "./dist/globals.js"
      }
    }
  }
}
