{
  "name": "@bunyad/database",
  "version": "0.2.0-beta.0",
  "description": "Query builder, schema builder, migrations and multi-driver connections (SQLite, PostgreSQL, MySQL, MariaDB, SQL Server) for Bunyad.",
  "license": "MIT",
  "author": "Shah Khalid",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunyadjs/framework.git",
    "directory": "packages/database"
  },
  "homepage": "https://github.com/bunyadjs/framework#readme",
  "bugs": {
    "url": "https://github.com/bunyadjs/framework/issues"
  },
  "keywords": [
    "bunyad",
    "bun",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "bun": "./src/index.bun.ts",
      "node": "./src/index.node.ts",
      "types": "./src/index.ts",
      "default": "./src/index.node.ts"
    },
    "./bun": "./src/index.bun.ts",
    "./node": "./src/index.node.ts"
  },
  "dependencies": {
    "@bunyad/common": "workspace:^"
  },
  "peerDependencies": {
    "pg": "^8.13.0",
    "mysql2": "^3.11.0",
    "better-sqlite3": ">=9.0.0",
    "bcrypt": ">=5.0.0",
    "bcryptjs": ">=2.4.0",
    "mssql": "^12.7.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "bcrypt": {
      "optional": true
    },
    "bcryptjs": {
      "optional": true
    },
    "mssql": {
      "optional": true
    }
  },
  "scripts": {
    "test": "bun test",
    "test:node": "node --experimental-transform-types --test src/driver-conformance.node-test.ts src/platforms-node.node-test.ts ../orm/src/where-has.node-test.ts",
    "smoke:node": "node --experimental-transform-types scripts/node-postgres-smoke.mjs",
    "build": "bun ../../scripts/build-package.ts .",
    "test:node:tsx": "node --import tsx --test src/driver-conformance.node-test.ts src/platforms-node.node-test.ts ../orm/src/where-has.node-test.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.15.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "mysql2": "^3.24.5",
    "pg": "^8.16.0",
    "mssql": "^12.7.0",
    "tsx": "^4.20.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "bun": "./dist/index.bun.js",
        "node": "./dist/index.node.js",
        "default": "./dist/index.node.js"
      },
      "./bun": {
        "types": "./dist/index.bun.d.ts",
        "default": "./dist/index.bun.js"
      },
      "./node": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      }
    }
  }
}
