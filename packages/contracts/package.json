{
  "name": "@bunyad/contracts",
  "version": "0.2.0-beta.1",
  "description": "Shared TypeScript interfaces for Bunyad packages.",
  "license": "MIT",
  "author": "Shah Khalid",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunyadjs/framework.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/bunyadjs/framework#readme",
  "bugs": {
    "url": "https://github.com/bunyadjs/framework/issues"
  },
  "keywords": [
    "bunyad",
    "bun",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "build": "bun ../../scripts/build-package.ts ."
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
