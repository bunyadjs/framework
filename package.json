{
  "name": "bunyad",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*",
    "templates/api",
    "templates/views",
    "templates/live",
    "templates/react",
    "templates/vue",
    "templates/svelte",
    "templates/saas",
    "docs/examples/orm-node-express"
  ],
  "bin": {
    "bunyad": "./packages/cli/src/bunyad.ts"
  },
  "scripts": {
    "bunyad": "bun packages/cli/src/bunyad.ts",
    "test": "bun test packages scripts apps/playground apps/my-api apps/my-app apps/my-saas apps/my-live apps/my-react apps/my-vue apps/my-svelte templates/api templates/views templates/live templates/react templates/vue templates/svelte templates/saas",
    "typecheck": "for p in packages/*/; do [ -f \"$p/tsconfig.json\" ] && { bunx tsc -p \"$p\" --noEmit || exit 1; }; done",
    "playground": "bun run apps/playground/server.ts",
    "serve": "bun run apps/playground/server.ts",
    "compile": "bun run apps/playground/bunyad compile",
    "start:compiled": "bun run apps/playground/bunyad start",
    "routes": "bun run apps/playground/bunyad route:list",
    "bench": "bun benchmarks/run.ts",
    "bench:competitors": "bun benchmarks/competitors/compare.ts",
    "bench:orm": "bun benchmarks/orm/compare.ts",
    "bench:summarize": "bun benchmarks/scripts/summarize-results.ts",
    "bench:regression": "bun benchmarks/scripts/check-regression.ts",
    "release:build": "bun scripts/release.ts build",
    "release:pack": "bun scripts/release.ts pack",
    "release:publish": "bun scripts/release.ts publish"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mssql": "^12.3.0",
    "typescript": "^5.9.2"
  }
}
