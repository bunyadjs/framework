<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@if(meta.title){{ meta.title }} - @endif{{ config('app.name') }}</title>
  <script>
    {{-- Apply the saved appearance before first paint. "system" follows the OS. --}}
    (() => {
      const appearance = localStorage.getItem("appearance") ?? "system";
      if (appearance !== "system") document.documentElement.dataset.theme = appearance;
    })();
  </script>
  <link rel="stylesheet" href="/build/app.css" />
</head>
<body class="min-h-screen bg-base-200">
  {{-- Wraps every page. Put here what every page shares; the layouts of the folders below nest inside it. --}}
  {!! children !!}
</body>
</html>
