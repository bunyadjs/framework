APP_NAME="Bunyad SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000
PORT=3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# `log` writes password reset and verification mail to the log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"

QUEUE_CONNECTION=memory

# Stripe (test keys from dashboard.stripe.com)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_PRICE_PRO=
