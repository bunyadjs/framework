<div class="flex flex-col gap-6">
  <x-auth-header title="Reset password" description="Please enter your new password below" />

  <form live:submit="resetPassword" class="flex flex-col gap-4">
    <fieldset class="fieldset">
      <label class="label" for="email">Email</label>
      <input id="email" type="email" live:model.defer="email" value="{{ email }}" class="input w-full" required autocomplete="email" />
      @error('email')<p class="text-sm text-error">{{ message }}</p>@enderror
    </fieldset>

    <fieldset class="fieldset">
      <label class="label" for="password">Password</label>
      <input id="password" type="password" live:model.defer="password" class="input w-full" required autofocus autocomplete="new-password" placeholder="Password" />
      @error('password')<p class="text-sm text-error">{{ message }}</p>@enderror
    </fieldset>

    <fieldset class="fieldset">
      <label class="label" for="password_confirmation">Confirm password</label>
      <input id="password_confirmation" type="password" live:model.defer="password_confirmation" class="input w-full" required autocomplete="new-password" placeholder="Confirm password" />
    </fieldset>

    <button type="submit" class="btn btn-primary w-full">Reset password</button>
  </form>
</div>
