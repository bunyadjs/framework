{{-- `active` names the current page. Live updates post to /live/update, so the route name can't tell. --}}
@props({ heading: "", subheading: "", active: "" })
<div class="mb-8">
  <h1 class="text-2xl font-semibold">Settings</h1>
  <p class="text-base-content/70">Manage your profile and account settings</p>
</div>

<div class="flex flex-col gap-8 md:flex-row">
  <ul class="menu w-full shrink-0 p-0 md:w-56">
    <li><a href="{{ route('profile.edit') }}" live:navigate @class({ 'menu-active': active === 'profile' })>Profile</a></li>
    <li><a href="{{ route('password.edit') }}" live:navigate @class({ 'menu-active': active === 'password' })>Password</a></li>
    <li><a href="{{ route('two-factor.show') }}" live:navigate @class({ 'menu-active': active === 'two-factor' })>Two-factor auth</a></li>
    <li><a href="{{ route('appearance.edit') }}" live:navigate @class({ 'menu-active': active === 'appearance' })>Appearance</a></li>
  </ul>

  <section class="w-full max-w-lg">
    <h2 class="text-lg font-semibold">{{ heading }}</h2>
    <p class="mb-6 text-sm text-base-content/70">{{ subheading }}</p>
    {!! slot !!}
  </section>
</div>
